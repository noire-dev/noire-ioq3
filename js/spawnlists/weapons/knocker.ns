spawn_model = "models/weapons3/lightning/lightning"
spawn_classname = "sb.shooter"
spawn_private = 0
spawn_colsize = 10
spawn_grid = 10
spawn_spawnflags = 20
spawn_material = 0
spawn_phys = 1
spawn_coll = 1
spawn_sound = "none"
spawn_health = -1
spawn_lightred = 0
spawn_lightgreen = 0
spawn_lightblue = 0
spawn_lightradius = 0
spawn_scalex = 1
spawn_scaley = 1
spawn_scalez = 1
spawn_type = 1
spawn_bounce = 0.40
spawn_mass = 1.00

command (EXEC_INSERT "sl prop $spawn_model$ $spawn_classname$ $spawn_private$ $spawn_colsize$ $spawn_grid$ $spawn_spawnflags$ $spawn_material$ $spawn_phys$ $spawn_coll$ $spawn_sound$ $spawn_health$ $spawn_lightred$ $spawn_lightgreen$ $spawn_lightblue$ $spawn_lightradius$ $spawn_scalex$ $spawn_scaley$ $spawn_scalez$ $spawn_type$ $spawn_bounce$ $spawn_mass$")
